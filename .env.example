NEXT_PUBLIC_READY_RUNTIME_MODE=demo
NEXT_PUBLIC_READY_CALENDAR_MODE=mock
NEXT_PUBLIC_READY_WEATHER_MODE=mock
# Future server-only integration credentials belong in .env.local.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# Server-only Mapbox token for address geocoding and directions. Never prefix with NEXT_PUBLIC_.
# Travel is skipped in the submission demo until a starting address is supplied.
TRAVEL_PROVIDER=mapbox
# MAPBOX_ACCESS_TOKEN=
# Optional legacy Google Routes provider; set TRAVEL_PROVIDER=google to use it.
# GOOGLE_MAPS_API_KEY=
# TODOIST_CLIENT_ID=
# TODOIST_CLIENT_SECRET=
# WEATHER_API_KEY=
